# ============================================================
# Moodle Deadlines Dashboard — exemplo de configuração
# Copiar para .env e preencher. NUNCA versionar o .env.
#
# Nota: se não existir .env, a página mostra um assistente de primeira
# configuração. Basta indicar o ano letivo, o número de aluno e a
# palavra-passe; o dashboard obtém um token e cria este ficheiro.
# ============================================================

# Base usada pelo assistente para construir o URL do ano letivo.
# O URL final fica, por exemplo, https://moodle.unips.pt/2627/.
MOODLE_BASE_URL=https://moodle.unips.pt

# URL base do Moodle (sem barra final é aceite). Quando o assistente cria
# o .env, este valor já inclui o ano letivo.
MOODLE_URL=https://moodle.exemplo.pt

# --- Autenticação -------------------------------------------------
# Preferir token ou URL iCal à password, quando disponível.

# Credenciais usadas pelo scripts/probe.js ou para configuração manual.
# O assistente usa a password apenas em memória para obter um token e
# nunca a escreve em data/, logs ou no .env.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Token do serviço mobile, se já o tiveres (opcional).
# Pode ser obtido em /user/managetoken.php ou via /login/token.php.
MOODLE_TOKEN=

# Serviço web a usar no pedido de token.
MOODLE_SERVICE=moodle_mobile_app

# URL de exportação iCal (opcional). Inclui normalmente um authtoken:
# https://moodle.exemplo.pt/calendar/export_execute.php?userid=...&authtoken=...
MOODLE_ICAL_URL=

# --- Servidor -----------------------------------------------------
# O servidor escuta sempre em 127.0.0.1 (não configurável por segurança).
PORT=3000

# --- Semestre -----------------------------------------------------
# Primeiro dia de aulas do semestre corrente (AAAA-MM-DD), usado para
# converter "semana N" numa data.
SEMESTER_START=2026-09-14
SEMESTER_TIMEZONE=Europe/Lisbon

# --- Pedidos ao Moodle --------------------------------------------
# Pausa entre pedidos sequenciais, em milissegundos. Não baixar sem razão.
PROBE_DELAY_MS=800
MOODLE_DELAY_MS=800

# Tempo de vida do cache local do dashboard, em minutos (0 = sem cache).
CACHE_TTL_MINUTES=15

# --- Extração de ficheiros (Fase 2) -------------------------------
# Limite de ficheiros descarregados por cadeira; 0 = sem limite.
MAX_FILES_PER_COURSE=40

# Tamanho máximo de cada ficheiro, em MB.
MAX_FILE_MB=20

# Limite total de bytes descarregados numa análise, em MB (0 = sem limite).
MAX_TOTAL_MB=250

# --- LLM opcional (Fase 5, desativado por defeito) ----------------
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
